<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- 콘솔 출력 -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %5level [%15.15thread] %40.40logger{40} : %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Loki 전송 (logfmt 형식) -->
    <appender name="LOKI" class="com.github.loki4j.logback.Loki4jAppender">
        <http>
            <url>http://${LOKI_HOST:-localhost}:3100/loki/api/v1/push</url>
        </http>
        <format>
            <label>
                <pattern>application=${APP_NAME:-stock-test},level=%level</pattern>
            </label>
            <message>
                <pattern>timestamp=%d{yyyy-MM-dd HH:mm:ss.SSS} level=%level thread=%thread logger=%logger{36} msg="%msg"%n</pattern>
            </message>
        </format>
    </appender>

    <!-- 로그 레벨 설정 -->
    <logger name="org.test.stock" level="INFO"/>
    <logger name="org.springframework" level="WARN"/>
    <logger name="org.hibernate" level="WARN"/>
    <logger name="com.zaxxer.hikari" level="INFO"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="LOKI"/>
    </root>
</configuration>
